# ==============================================================================
# AEGIS-RF: Microchip PolarFire SoC Libero Timing Constraints (SDC)
# Target Device: MPFS250T-FCVG484E (PolarFire SoC Icicle Kit)
# Operating Clocks: 100 MHz Streaming DSP / 50 MHz MSS Reference
# ==============================================================================

# Primary Reference Oscillator (On-Board 50 MHz Oscillator)
create_clock -name {REF_CLK_50M} -period 20.000 -waveform {0.000 10.000} [get_ports {REF_CLK_50MHZ}]

# Core Fabric Streaming DSP Clock generated by CCC/PLL (100.0 MHz Target)
create_clock -name {FABRIC_CLK_100M} -period 10.000 -waveform {0.000 5.000} [get_pins {CCC_0/GL0}]

# AXI4-Lite Supervisory Control Bus Clock (50.0 MHz)
create_clock -name {AXI_LITE_CLK_50M} -period 20.000 -waveform {0.000 10.000} [get_pins {CCC_0/GL1}]

# Clock Uncertainty and Jitter Margins
set_clock_uncertainty -setup 0.250 [get_clocks {FABRIC_CLK_100M}]
set_clock_uncertainty -hold 0.150 [get_clocks {FABRIC_CLK_100M}]
set_clock_uncertainty -setup 0.300 [get_clocks {AXI_LITE_CLK_50M}]

# Clock Domain Crossing (CDC) False Paths
# AXI-Lite shadow registers latched into DSP domain via dedicated sof_sync pulse
set_false_path -from [get_cells {u_axi4_lite_regs/r_shadow_*}] -to [get_cells {u_axi4_lite_regs/r_active_*}]

# Input / Output Delay Constraints for AXI4-Stream Slave Interface
set_input_delay -clock {FABRIC_CLK_100M} -max 2.500 [get_ports {s_axis_tdata* s_axis_tvalid s_axis_tlast}]
set_input_delay -clock {FABRIC_CLK_100M} -min 0.500 [get_ports {s_axis_tdata* s_axis_tvalid s_axis_tlast}]
set_output_delay -clock {FABRIC_CLK_100M} -max 2.500 [get_ports {s_axis_tready}]

# Asynchronous Active-Low Reset
set_false_path -from [get_ports {rst_n}]
